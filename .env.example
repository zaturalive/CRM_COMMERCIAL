# ============================================================================
# CRM Commercial — variables d'environnement
# Copier ce fichier vers .env et remplir les vraies valeurs
# Ne JAMAIS committer le .env (cf .gitignore)
# Ports decales du repo CRM_chirurgien (3300/4100/5432 interne) pour permettre
# aux 2 projets de tourner en parallele sur la meme machine.
# ============================================================================

# ─── Secrets (generer avec : openssl rand -hex 32) ─────────────────────────
JWT_SECRET=dev-jwt-secret-please-change-min-32-bytes-random
NEXTAUTH_SECRET=dev-nextauth-secret-please-change-min-32-bytes

# ─── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_DB=crm_commercial
# URL complete (utilisee par Prisma dans le container backend)
DATABASE_URL=postgresql://postgres:dev@postgres:5432/crm_commercial

# ─── URLs frontend / backend ──────────────────────────────────────────────
# Local dev (ports exposes directement par docker-compose)
FRONTEND_URL=http://localhost:3300
BACKEND_URL=http://localhost:4100
NEXT_PUBLIC_BACKEND_URL=http://localhost:4100
NEXTAUTH_URL=http://localhost:3300

# ─── Uploads ──────────────────────────────────────────────────────────────
UPLOADS_DIR=/app/uploads

# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
NEXT_PUBLIC_DEMO_MODE=true

# ─── PROD — surcharger dans .env.prod ─────────────────────────────────────
# NODE_ENV=production
# FRONTEND_URL=https://crm-commercial.<domaine-editeur>.com
# NEXTAUTH_URL=https://crm-commercial.<domaine-editeur>.com
# DATABASE_URL=postgresql://postgres:<prod-pw>@postgres:5432/crm_commercial
# NEXT_PUBLIC_DEMO_MODE=false
