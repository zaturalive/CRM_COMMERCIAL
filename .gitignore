# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Testing
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/

# Next.js
.next/
out/
build/
dist/

# Le package partage @crm/shared expose ses declarations (.d.ts) + JS compile
# pour que tsc (backend) et le runtime de prod resolvent la source unique
# computeDevisTotal (ADR-0009 D6) sans etape de build prealable obligatoire.
# Regenerable via `npm run build -w @crm/shared`.
!packages/shared/dist/
!packages/shared/dist/**

# Production
*.tsbuildinfo
next-env.d.ts

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pino.log

# Local env files (never commit secrets)
.env
.env*.local
.env.production
.env.development
.env.prod

# MCP config contient le BYAN_API_KEY en dur — ne pas committer
.mcp.json

# Prisma
apps/backend/prisma/migrations/dev.db
apps/backend/prisma/migrations/dev.db-journal
.prisma/

# SQL dumps / backups (peuvent contenir donnees clients — jamais commit)
*.sql
!apps/backend/prisma/migrations/**/*.sql
!apps/backend/scripts/*.sql

# seed.local.ts : variante locale avec vraies donnees client (jamais commit).
# seed.ts est desormais committable et ne contient que tenants + catalogues.
apps/backend/prisma/seed.local.ts

# Extraits clients bruts (RGPD : contient noms patients dans certaines feuilles)
docs/extrait_delobaux/*.xlsx
docs/extrait_delobaux/*.xls
docs/extrait_delobaux/*.csv

# Uploads (documents pre-op, jamais commit)
uploads/
apps/backend/uploads/

# IDE
.idea/
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
*.pid

# BYAN output
_byan-output/
_bmad-output/

# Temp files
.tmp-*/
*.tmp
*.bak

# Zip prototype (garde-le en local mais pas en git)
crm_chirurgien_design.zip
"files(2)"/uploads/

# Logs
# Ancre a la racine : un pattern "logs/" non ancre capturait aussi la route
# Back Office apps/frontend/src/app/admin/logs (page EP17-S05). On ne veut
# ignorer qu'un eventuel repertoire de sortie de logs a la racine du repo.
/logs/
*.log
!apps/frontend/src/app/admin/logs/
docker/.env
