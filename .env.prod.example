# ============================================================================
# CRM Commercial — variables d'environnement PROD
# Copier vers .env.prod sur le serveur et remplir avec les vraies valeurs.
# .env.prod est gitignored — ne JAMAIS commiter avec de vrais secrets.
#
# Projet jumeau non-HDS — voir ADR-0008 du repo crm-chirurgien et
# docs/document-reference-complet-crm-commercial.md pour le contexte.
# ============================================================================

# ─── Domaine ──────────────────────────────────────────────────────────────
# A definir avec l'editeur (entreprise mexicaine). Ex : crm-commercial.<editeur>.com
DOMAIN=crm-commercial.example.com

# ─── Secrets (a generer avec : openssl rand -hex 32) ──────────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_hex_32

# ─── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=crm_commercial_prod
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=crm_commercial

# ─── URLs — single domain ─────────────────────────────────────────────────
# Tout pointe sur le meme domaine. Le frontend appelle /api/* en relatif,
# le backend filtre par tenantId via la session JWT (extended Prisma client).
NEXT_PUBLIC_BACKEND_URL=https://crm-commercial.example.com
NEXTAUTH_URL=https://crm-commercial.example.com
FRONTEND_URL=https://crm-commercial.example.com
BACKEND_URL=http://backend:4000

# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=warn
# Active le switcher de role + les routes /api/demo meme en prod
# (utile tant qu'on est en phase demo vitrine). Passer a false en prod reelle.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_MODE=true

# ─── Uploads ──────────────────────────────────────────────────────────────
UPLOADS_DIR=/app/uploads
