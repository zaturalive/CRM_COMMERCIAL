# ============================================================================
# CRM Commercial (Vencor) — variables d'environnement PROD
# Copier vers .env.prod sur le serveur et remplir avec les vraies valeurs.
# .env.prod est gitignored — a ne PAS commiter avec de vrais secrets.
# Lancement : docker compose -f docker/docker-compose.prod.yml --env-file .env.prod up -d
# ============================================================================

# ─── Domaine ──────────────────────────────────────────────────────────────
DOMAIN=vencor-crm.com

# ─── Secrets (generer : openssl rand -hex 32) ─────────────────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_hex_32

# ─── Chiffrement at-rest (ADR-0009 D4) — OBLIGATOIRE ──────────────────────
# Sans ces cles le backend refuse de booter (donnees client chiffrees AES-256-GCM).
# AT_REST_KEY : 32 octets base64  ->  openssl rand -base64 32
AT_REST_KEY=CHANGE_ME_openssl_rand_base64_32
# EMAIL_SEARCH_KEY : >= 32 caracteres (HMAC recherche email)  ->  openssl rand -hex 32
EMAIL_SEARCH_KEY=CHANGE_ME_openssl_rand_hex_32

# ─── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=crm_commercial_prod
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=crm_commercial

# ─── URLs — single domain ─────────────────────────────────────────────────
# Tout pointe sur le meme domaine. Le frontend appelle /api/* en relatif ;
# le backend filtre par tenantId via la session JWT (extended Prisma client).
NEXT_PUBLIC_BACKEND_URL=https://vencor-crm.com
NEXTAUTH_URL=https://vencor-crm.com
FRONTEND_URL=https://vencor-crm.com
BACKEND_URL=http://backend:4000

# ─── Email (Brevo SMTP) — OBLIGATOIRE pour l'onboarding ───────────────────
# L'invitation par email est le SEUL moyen de creer un compte (pas de mot de
# passe affiche). Sans MAIL_*, MAIL_PROVIDER tombe sur "noop" -> aucun envoi.
# Cle SMTP : Brevo Dashboard > SMTP & API > SMTP. Domaine a authentifier (DKIM/DMARC).
MAIL_PROVIDER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=CHANGE_ME_login_smtp_brevo
MAIL_PASS=CHANGE_ME_cle_smtp_brevo
MAIL_FROM=no-reply@vencor-crm.com

# ─── Connexion Google (SSO) — optionnel ───────────────────────────────────
# Client OAuth (Google Cloud Console). Redirect autorise :
#   https://vencor-crm.com/api/auth/callback/google
# Laisser vide -> le bouton "Se connecter avec Google" ne s'affiche pas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secret partage serveur-a-serveur (generer : openssl rand -base64 32)
GOOGLE_SSO_SHARED_SECRET=

# ─── Sous-domaines par cabinet (EP14-S03) — optionnel ─────────────────────
# Si actives : wildcard DNS *.vencor-crm.com + cert TLS wildcard (cote infra).
# Cookie de session partage apex <-> sous-domaines + domaine racine inline au build.
# Laisser vide -> fallback apex (login avec code cabinet, sans sous-domaine).
AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_BASE_DOMAIN=

# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=warn
# DEMO_MODE : switcher de role + routes /api/demo (phase vitrine). Passer a
# false pour un vrai client (sinon n'importe qui peut changer de role).
NEXT_PUBLIC_DEMO_MODE=true
DEMO_MODE=true

# ─── Uploads ──────────────────────────────────────────────────────────────
UPLOADS_DIR=/app/uploads
